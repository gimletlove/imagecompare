[Desktop Entry]
Name=Image Compare
Comment=Compare images and visual differences
Exec=imagecompare %F
Icon=io.github.gimletlove.imagecompare
Type=Application
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;
Keywords=image;compare;comparison;diff;visual;visual diff;heatmap;perceptual;difference;
MimeType=image/png;image/jpeg;image/webp;image/avif;image/jxl;image/heic;image/heif;image/tiff;image/bmp;image/svg;
